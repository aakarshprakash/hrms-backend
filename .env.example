APP_NAME="Peoplenex Powered By Sysnac"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Frontend origin, used as the default for CORS_ALLOWED_ORIGINS below.
FRONTEND_URL=http://localhost:5174
# Comma-separated list of origins allowed to call this API. Update this to
# the real frontend domain (e.g. Cloudflare Pages URL) on deploy.
CORS_ALLOWED_ORIGINS=http://localhost:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms
DB_USERNAME=root
DB_PASSWORD=

# Only relevant if cookie-based SPA auth is used instead of the Bearer
# token flow this app currently uses.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173

# API token lifetime in minutes (default 7 days).
SANCTUM_EXPIRATION=10080

# Platform operator bootstrap (read once by ProductionSeeder; remove the
# password after first deploy). Or run: php artisan platform:admin you@example.com
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Subscriptions & billing (all optional) ─────────────────────────────────
# Self-serve sign-up from the login page (off by default).
PUBLIC_SIGNUP=false
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=growth
BILLING_GRACE_DAYS=7
# The seller printed on subscription invoices (GST).
BILLING_SELLER_NAME="Sysnac Technologies"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_STATE=Kerala
BILLING_SELLER_GSTIN=
BILLING_BANK_DETAILS=
BILLING_INVOICE_PREFIX=PNX
# Online payment of invoices (Razorpay Payment Links); without keys, invoices are settled offline.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
